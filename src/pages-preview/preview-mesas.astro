---
import MainLayout from '../layouts/MainLayout.astro';
import MesasHero from '../components/MesasHero.astro';
import MesasCatalog from '../components/MesasCatalog.astro';
import MesasPreFooter from '../components/MesasPreFooter.astro';
---

<MainLayout
  title="Catálogo de Mesas de Arrime | Dodera Hermanos Marmolería"
  description="Mesas con estructura de hierro y tapas de piedra. Conocé los modelos y terminaciones disponibles."
  canonicalPath="/preview-mesas"
  ogImage="/assets/mesas/modelo-01.jpg"
  headerTheme="light"
  activeNav="Catálogo"
  noIndex={true}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Mesas de Arrime', path: '/preview-mesas' }
  ]}
>
  <!-- Hero Compacto Editorial con Recorte Orgánico -->
  <MesasHero />

  <!-- Grilla Editorial de 2 Columnas en Escritorio + Nota Provisional -->
  <MesasCatalog />

  <!-- Franja de Consulta por WhatsApp -->
  <MesasPreFooter />
</MainLayout>
