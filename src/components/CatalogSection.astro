---
import { CATALOG_HOME_CARDS, resolveCatalogCardHref } from '../data/catalogos';
---

<section class="catalogo-section" id="catalogos">
  <div class="container catalogo-container">
    <!-- Bloque Introductorio a la izquierda -->
    <div class="catalogo-intro">
      <p class="section-tag">CATÁLOGO</p>
      <h2 class="section-heading">
        Materiales<br />
        y productos<br />
        para tu espacio.
      </h2>
      <p class="section-lead">
        Una cuidada selección de piedras, terminaciones y complementos para proyectos residenciales y comerciales.
      </p>
    </div>

    <!-- Las Tres Tarjetas Fotográficas Altas con Esquinas Superiores Redondeadas -->
    <div class="catalogo-cards-grid">
      {
        CATALOG_HOME_CARDS.map((card) => {
          const targetHref = resolveCatalogCardHref(card);
          const isExternal = targetHref.startsWith('http');
          return (
            <article class:list={['catalogo-card', card.isWide ? 'card-wide' : 'card-narrow']}>
              <a
                href={targetHref}
                class="catalogo-card-full-link"
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                aria-label={`Ver catálogo de ${card.title}`}
              >
                <div class="catalogo-card-media">
                  <img
                    src={card.image}
                    alt={card.imageAlt}
                    class="card-img"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="card-gradient"></div>
                </div>
                <div class="catalogo-card-content">
                  <div class="card-info">
                    <span class="card-num">{card.num}</span>
                    <h3 class="card-title">{card.title}</h3>
                  </div>
                  <span class="card-circle-btn" aria-hidden="true">
                    <span class="arrow-glyph">→</span>
                  </span>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .catalogo-card-full-link {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
</style>
