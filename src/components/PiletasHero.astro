---
import { PILETAS_HERO_CONTENT } from '../data/piletas';

export interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = PILETAS_HERO_CONTENT.eyebrow,
  title = PILETAS_HERO_CONTENT.title,
  description = PILETAS_HERO_CONTENT.description
} = Astro.props;
---

<section class="piletas-hero" aria-labelledby="piletas-hero-title">
  <div class="container container-wide piletas-hero-container">
    <!-- Columna Izquierda: Jerarquía Editorial -->
    <div class="hero-text-col">
      <div class="hero-eyebrow-wrapper">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        <span class="hero-eyebrow">{eyebrow}</span>
      </div>

      <h1 class="hero-main-title" id="piletas-hero-title">
        {title}
      </h1>

      <p class="hero-lead-desc">
        {description}
      </p>
    </div>

    <!-- Columna Derecha: Recorte Arquitectónico con Cotas CAD -->
    <div class="hero-cad-col" aria-hidden="true">
      <div class="cad-composition">
        <!-- Fotografía con Corte de Arco Cuarto de Círculo -->
        <div class="cad-image-frame">
          <img
            src="/assets/piletas/hero-stone-cad.jpg"
            alt="Mecanizado y traforo de piedra natural en taller"
            class="cad-image"
            width="420"
            height="240"
            fetchpriority="high"
          />
        </div>

        <!-- Superposición Gráfica SVG: Cotas Técnicas CAD (R 420 y 240) -->
        <svg
          class="cad-dimension-lines"
          viewBox="0 0 460 260"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Arco de Cota de Radio R 420 -->
          <path
            d="M 40,240 A 200,200 0 0,1 240,40"
            stroke="rgba(18, 18, 16, 0.45)"
            stroke-width="1"
            stroke-dasharray="2 2"
          />

          <!-- Línea Guía y Flecha de Radio -->
          <line
            x1="180"
            y1="60"
            x2="155"
            y2="35"
            stroke="rgba(18, 18, 16, 0.65)"
            stroke-width="1"
          />
          <polygon
            points="180,60 173,53 177,50"
            fill="rgba(18, 18, 16, 0.85)"
          />

          <!-- Texto Cota R 420 -->
          <text
            x="115"
            y="32"
            font-family="'Plus Jakarta Sans', monospace, sans-serif"
            font-size="11"
            letter-spacing="0.1em"
            fill="rgba(18, 18, 16, 0.75)"
            font-weight="500"
          >
            R 420
          </text>

          <!-- Cota Vertical Derecha (240) -->
          <!-- Líneas de extensión horizontal superior e inferior -->
          <line
            x1="410"
            y1="10"
            x2="445"
            y2="10"
            stroke="rgba(18, 18, 16, 0.35)"
            stroke-width="0.8"
          />
          <line
            x1="410"
            y1="250"
            x2="445"
            y2="250"
            stroke="rgba(18, 18, 16, 0.35)"
            stroke-width="0.8"
          />

          <!-- Línea de cota vertical -->
          <line
            x1="438"
            y1="10"
            x2="438"
            y2="110"
            stroke="rgba(18, 18, 16, 0.45)"
            stroke-width="0.8"
          />
          <line
            x1="438"
            y1="150"
            x2="438"
            y2="250"
            stroke="rgba(18, 18, 16, 0.45)"
            stroke-width="0.8"
          />

          <!-- Flechas extremas vertical -->
          <polyline
            points="435,16 438,10 441,16"
            stroke="rgba(18, 18, 16, 0.75)"
            stroke-width="1"
            fill="none"
          />
          <polyline
            points="435,244 438,250 441,244"
            stroke="rgba(18, 18, 16, 0.75)"
            stroke-width="1"
            fill="none"
          />

          <!-- Texto Cota 240 -->
          <text
            x="430"
            y="134"
            font-family="'Plus Jakarta Sans', monospace, sans-serif"
            font-size="11"
            letter-spacing="0.08em"
            fill="rgba(18, 18, 16, 0.75)"
            font-weight="500"
          >
            240
          </text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .piletas-hero {
    background-color: var(--color-bg-warm, #F9F8F5);
    padding-top: calc(var(--header-height, 80px) + 32px);
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(18, 18, 16, 0.06);
    position: relative;
    overflow: hidden;
  }

  .piletas-hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 48px;
    min-height: 280px;
  }

  /* TEXTO / EDITORIAL */
  .hero-text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 580px;
  }

  .hero-eyebrow-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .eyebrow-rule {
    display: inline-block;
    width: 28px;
    height: 1px;
    background-color: var(--color-terracotta, #773508);
  }

  .hero-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5A5854;
  }

  .hero-main-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: #121210;
    margin: 0 0 18px 0;
  }

  .hero-lead-desc {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    color: #5A5854;
    margin: 0;
    max-width: 460px;
  }

  /* CAD / GRÁFICO ARQUITECTÓNICO */
  .hero-cad-col {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .cad-composition {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 16 / 10;
  }

  .cad-image-frame {
    position: absolute;
    top: 10px;
    right: 32px;
    width: 86%;
    height: 88%;
    border-top-left-radius: 90% 100%;
    overflow: hidden;
    background-color: #E2DDD5;
    box-shadow: 0 12px 32px -8px rgba(18, 18, 16, 0.08);
  }

  .cad-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.02);
  }

  .cad-dimension-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (max-width: 992px) {
    .piletas-hero-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-cad-col {
      justify-content: flex-start;
    }

    .cad-composition {
      max-width: 360px;
    }
  }

  @media (max-width: 640px) {
    .piletas-hero {
      padding-top: calc(var(--header-height, 80px) + 20px);
      padding-bottom: 20px;
    }

    .hero-main-title {
      font-size: 2.15rem;
      line-height: 1.12;
    }

    .hero-lead-desc {
      font-size: 0.9375rem;
    }

    .cad-composition {
      max-width: 280px;
    }
  }
</style>
