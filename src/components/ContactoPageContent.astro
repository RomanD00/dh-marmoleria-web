---
import {
  CONTACTO_WHATSAPP_NUMBER,
  CONTACTO_HERO_CONTENT,
  CONTACTO_FORM_CONFIG,
  CONTACTO_INFO_CONTENT,
  CONTACTO_PROFESIONALES_CONTENT,
  CONTACTO_DIFERENCIALES,
  CONTACTO_FINAL_CTA,
  getContactoWhatsAppUrl
} from '../data/contacto';

const directFormWhatsAppUrl = getContactoWhatsAppUrl(CONTACTO_FORM_CONFIG.directLinkMessage);
const infoWhatsAppUrl = getContactoWhatsAppUrl(CONTACTO_INFO_CONTENT.whatsappDirectMessage);
const profesionalesWhatsAppUrl = getContactoWhatsAppUrl(CONTACTO_PROFESIONALES_CONTENT.whatsappMessage);
const finalCtaWhatsAppUrl = getContactoWhatsAppUrl(CONTACTO_FINAL_CTA.whatsappMessage);
---

<div class="dh-contacto-page">
  <!-- A. Hero Compacto Exclusivamente Tipográfico -->
  <section class="dh-contacto-hero" aria-labelledby="dh-contacto-hero-title">
    <div class="container container-wide">
      <div class="dh-contacto-eyebrow-row">
        <span class="dh-contacto-rule-short" aria-hidden="true"></span>
        <span class="dh-contacto-eyebrow">{CONTACTO_HERO_CONTENT.eyebrow}</span>
      </div>

      <h1 class="dh-contacto-hero-title" id="dh-contacto-hero-title">
        Las grandes ideas empiezan<br />con una conversación.
      </h1>

      <p class="dh-contacto-hero-desc">
        {CONTACTO_HERO_CONTENT.description}
      </p>

      <div class="dh-contacto-hdivider" aria-hidden="true"></div>
    </div>
  </section>

  <!-- B & C. Sección Principal de Contacto en Dos Columnas -->
  <section class="dh-contacto-main" aria-label="Formulario e información de contacto">
    <div class="container container-wide">
      <div class="dh-contacto-columns">
        <!-- Columna Izquierda: Formulario de Consulta -->
        <div class="dh-contacto-form-col">
          <div class="dh-contacto-section-head">
            <span class="dh-contacto-rule-short" aria-hidden="true"></span>
            <h2 class="dh-contacto-col-title">{CONTACTO_FORM_CONFIG.title}</h2>
          </div>

          <form
            id="contactoWhatsappForm"
            class="dh-contacto-form"
            data-whatsapp-number={CONTACTO_WHATSAPP_NUMBER}
            data-default-perfil={CONTACTO_FORM_CONFIG.defaultPerfil}
            novalidate
          >
            <!-- 1. Nombre -->
            <div class="dh-contacto-field">
              <label for="contactoNombre" class="dh-contacto-label">
                {CONTACTO_FORM_CONFIG.nombreLabel}
              </label>
              <input
                id="contactoNombre"
                name="nombre"
                type="text"
                class="dh-contacto-input"
                placeholder={CONTACTO_FORM_CONFIG.nombrePlaceholder}
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="contactoNombreError"
              />
              <p id="contactoNombreError" class="dh-contacto-error-msg" role="alert" hidden>
                Por favor, ingresá tu nombre y apellido.
              </p>
            </div>

            <!-- 2. Perfil -->
            <fieldset class="dh-contacto-fieldset" data-choice-group="perfil">
              <legend class="dh-contacto-label">{CONTACTO_FORM_CONFIG.perfilLabel}</legend>
              <div class="dh-contacto-choice-grid dh-contacto-perfil-grid">
                {
                  CONTACTO_FORM_CONFIG.perfiles.map((perfil) => {
                    const isDefault = perfil === CONTACTO_FORM_CONFIG.defaultPerfil;
                    return (
                      <button
                        type="button"
                        class:list={['dh-contacto-choice-btn', { 'is-selected': isDefault }]}
                        data-perfil={perfil}
                        aria-pressed={isDefault ? 'true' : 'false'}
                      >
                        {perfil}
                      </button>
                    );
                  })
                }
              </div>
            </fieldset>

            <!-- 3. Tipo de consulta -->
            <fieldset class="dh-contacto-fieldset" data-choice-group="tipo">
              <legend class="dh-contacto-label">{CONTACTO_FORM_CONFIG.tipoLabel}</legend>
              <div class="dh-contacto-choice-grid dh-contacto-tipo-grid">
                {
                  CONTACTO_FORM_CONFIG.tiposConsulta.map((tipo) => (
                    <button
                      type="button"
                      class="dh-contacto-choice-btn"
                      data-tipo={tipo}
                      aria-pressed="false"
                    >
                      {tipo}
                    </button>
                  ))
                }
              </div>
              <p id="contactoTipoError" class="dh-contacto-error-msg" role="alert" hidden>
                Por favor, seleccioná un tipo de consulta.
              </p>
            </fieldset>

            <!-- 4. Descripción -->
            <div class="dh-contacto-field">
              <label for="contactoDescripcion" class="dh-contacto-label">
                {CONTACTO_FORM_CONFIG.descripcionLabel}
              </label>
              <textarea
                id="contactoDescripcion"
                name="descripcion"
                rows="4"
                class="dh-contacto-textarea"
                placeholder={CONTACTO_FORM_CONFIG.descripcionPlaceholder}
              ></textarea>
            </div>

            <!-- 5. CTA Principal + Enlace Directo -->
            <div class="dh-contacto-submit-wrap">
              <button type="submit" id="contactoSubmitBtn" class="dh-contacto-btn-primary">
                <svg
                  class="dh-contacto-icon-wa"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                  ></path>
                </svg>
                <span>{CONTACTO_FORM_CONFIG.submitLabel}</span>
              </button>

              <a
                href={directFormWhatsAppUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="dh-contacto-direct-link"
              >
                {CONTACTO_FORM_CONFIG.directLinkLabel}
              </a>
            </div>
          </form>
        </div>

        <!-- Divisor Vertical Sutil en Escritorio -->
        <div class="dh-contacto-vdivider" aria-hidden="true"></div>

        <!-- Columna Derecha: Información de Contacto y Profesionales -->
        <aside class="dh-contacto-info-col" aria-label="Canales de contacto">
          <div class="dh-contacto-section-head">
            <span class="dh-contacto-rule-short" aria-hidden="true"></span>
            <h2 class="dh-contacto-col-title">{CONTACTO_INFO_CONTENT.title}</h2>
          </div>

          <ul class="dh-contacto-info-list">
            <!-- WhatsApp -->
            <li class="dh-contacto-info-item">
              <div class="dh-contacto-info-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                  ></path>
                </svg>
              </div>
              <span class="dh-contacto-info-vsep" aria-hidden="true"></span>
              <div class="dh-contacto-info-body">
                <span class="dh-contacto-info-heading">WhatsApp</span>
                <a
                  href={infoWhatsAppUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="dh-contacto-info-link"
                >
                  {CONTACTO_INFO_CONTENT.whatsappDisplay}
                </a>
              </div>
            </li>

            <!-- Cobertura -->
            <li class="dh-contacto-info-item">
              <div class="dh-contacto-info-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <span class="dh-contacto-info-vsep" aria-hidden="true"></span>
              <div class="dh-contacto-info-body">
                <span class="dh-contacto-info-heading">Cobertura</span>
                <span class="dh-contacto-info-text">{CONTACTO_INFO_CONTENT.cobertura}</span>
              </div>
            </li>

            <!-- Horarios -->
            <li class="dh-contacto-info-item">
              <div class="dh-contacto-info-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <polyline points="12 7 12 12 15.5 13.5"></polyline>
                </svg>
              </div>
              <span class="dh-contacto-info-vsep" aria-hidden="true"></span>
              <div class="dh-contacto-info-body">
                <span class="dh-contacto-info-heading">Horarios</span>
                {
                  CONTACTO_INFO_CONTENT.horarios.map((line) => (
                    <span class="dh-contacto-info-text">{line}</span>
                  ))
                }
              </div>
            </li>

            <!-- Redes sociales -->
            <li class="dh-contacto-info-item">
              <div class="dh-contacto-info-icon dh-contacto-info-icon-pair" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2c-2.72 0-4.58 1.66-4.58 4.7v2.62H6.61v3.56h3.07V22h3.68v-9.12h3.06l.46-3.56h-3.52V7.05c0-1.05.29-1.73 1.76-1.73z"
                  ></path>
                </svg>
              </div>
              <span class="dh-contacto-info-vsep" aria-hidden="true"></span>
              <div class="dh-contacto-info-body">
                <span class="dh-contacto-info-heading">Redes</span>
                <a
                  href={CONTACTO_INFO_CONTENT.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="dh-contacto-info-link"
                >
                  {CONTACTO_INFO_CONTENT.instagramLabel}
                </a>
                <a
                  href={CONTACTO_INFO_CONTENT.facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="dh-contacto-info-link"
                >
                  {CONTACTO_INFO_CONTENT.facebookLabel}
                </a>
              </div>
            </li>
          </ul>

          <!-- Bloque Asesoramiento para Profesionales -->
          <div class="dh-contacto-prof-block">
            <span class="dh-contacto-rule-short" aria-hidden="true"></span>
            <h3 class="dh-contacto-prof-title">{CONTACTO_PROFESIONALES_CONTENT.title}</h3>
            <p class="dh-contacto-prof-desc">{CONTACTO_PROFESIONALES_CONTENT.description}</p>
            <a
              href={profesionalesWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="dh-contacto-prof-link"
            >
              <span>{CONTACTO_PROFESIONALES_CONTENT.linkLabel}</span>
              <span class="dh-contacto-prof-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- E. Franja Horizontal de Diferenciales -->
  <section class="dh-contacto-diferenciales" aria-label="Diferenciales de atención">
    <div class="container container-wide">
      <div class="dh-contacto-dif-band">
        {
          CONTACTO_DIFERENCIALES.map((item) => (
            <div class="dh-contacto-dif-item">
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- F. CTA Final -->
  <section class="dh-contacto-final-cta" aria-labelledby="dh-contacto-final-title">
    <div class="container container-wide">
      <div class="dh-contacto-final-inner">
        <div class="dh-contacto-final-copy">
          <span class="dh-contacto-rule-short" aria-hidden="true"></span>
          <h2 class="dh-contacto-final-title" id="dh-contacto-final-title">
            {CONTACTO_FINAL_CTA.title}
          </h2>
          <p class="dh-contacto-final-desc">{CONTACTO_FINAL_CTA.description}</p>
        </div>

        <div class="dh-contacto-final-action">
          <a
            href={finalCtaWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="dh-contacto-btn-primary dh-contacto-btn-final"
          >
            <svg
              class="dh-contacto-icon-wa"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path>
            </svg>
            <span>{CONTACTO_FINAL_CTA.buttonLabel}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="dh-contacto-final-visual" aria-hidden="true">
      <img
        src={CONTACTO_FINAL_CTA.image}
        alt={CONTACTO_FINAL_CTA.imageAlt}
        class="dh-contacto-final-img"
        width="485"
        height="240"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</div>

<style>
  .dh-contacto-page {
    background-color: #F9F8F5;
    color: #1A1A1A;
  }

  .dh-contacto-page .container-wide {
    max-width: 1440px;
    padding-left: clamp(20px, 5vw, 72px);
    padding-right: clamp(20px, 5vw, 72px);
  }

  .dh-contacto-rule-short {
    display: block;
    width: 42px;
    height: 1.75px;
    background-color: #773508;
    flex-shrink: 0;
  }

  /* A. HERO COMPACTO (EXCLUSIVAMENTE TIPOGRÁFICO) */
  .dh-contacto-hero {
    padding-top: calc(var(--header-height, 90px) + 46px);
    padding-bottom: 0;
  }

  .dh-contacto-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 26px;
  }

  .dh-contacto-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1A1A1A;
  }

  .dh-contacto-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.65rem, 5.15vw, 4.65rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.022em;
    color: #1A1A1A;
    margin: 0 0 24px 0;
    max-width: 980px;
  }

  .dh-contacto-hero-desc {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.38vw, 1.24rem);
    font-weight: 400;
    line-height: 1.54;
    color: #2B2927;
    margin: 0 0 46px 0;
    max-width: 690px;
  }

  .dh-contacto-hdivider {
    width: 100%;
    height: 1px;
    background-color: rgba(26, 26, 26, 0.13);
  }

  /* B & C. SECCIÓN PRINCIPAL DOS COLUMNAS */
  .dh-contacto-main {
    padding: 54px 0 64px;
  }

  .dh-contacto-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) 1px minmax(0, 0.92fr);
    gap: clamp(32px, 3.8vw, 54px);
    align-items: start;
  }

  .dh-contacto-vdivider {
    width: 1px;
    height: 100%;
    min-height: 100%;
    background-color: rgba(26, 26, 26, 0.13);
    align-self: stretch;
  }

  .dh-contacto-section-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .dh-contacto-col-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 3.45vw, 3.1rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: #1A1A1A;
    margin: 0;
  }

  /* FORMULARIO */
  .dh-contacto-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .dh-contacto-field,
  .dh-contacto-fieldset {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .dh-contacto-label {
    font-family: var(--font-sans);
    font-size: 1.04rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: #1A1A1A;
    padding: 0;
  }

  .dh-contacto-input,
  .dh-contacto-textarea {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(26, 26, 26, 0.25);
    border-radius: 6px;
    padding: 14px 18px;
    font-family: var(--font-sans);
    font-size: 1.02rem;
    line-height: 1.48;
    color: #1A1A1A;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .dh-contacto-input {
    min-height: 54px;
  }

  .dh-contacto-textarea {
    min-height: 156px;
    padding: 18px 46px 18px 18px;
    resize: vertical;
  }

  .dh-contacto-input::placeholder,
  .dh-contacto-textarea::placeholder {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.22rem;
    line-height: 1.44;
    color: #3E3A36;
    opacity: 1;
  }

  .dh-contacto-input:hover,
  .dh-contacto-textarea:hover {
    border-color: rgba(119, 53, 8, 0.48);
  }

  .dh-contacto-input:focus-visible,
  .dh-contacto-textarea:focus-visible {
    outline: 2px solid #773508;
    outline-offset: 2px;
    background-color: #FFFFFF;
    border-color: #773508;
  }

  .dh-contacto-input.is-invalid {
    border-color: #9E2A1B;
    background-color: #FFFDFC;
  }

  .dh-contacto-error-msg {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: #9E2A1B;
    margin: 2px 0 0 0;
  }

  /* GRILLAS DE BOTONES DE SELECCIÓN */
  .dh-contacto-choice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .dh-contacto-choice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50px;
    padding: 11px 14px;
    border-radius: 7px;
    border: 1px solid rgba(26, 26, 26, 0.2);
    background-color: rgba(255, 255, 255, 0.54);
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.25;
    color: #1A1A1A;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.18s ease;
  }

  .dh-contacto-choice-btn:hover {
    border-color: rgba(119, 53, 8, 0.55);
    background-color: rgba(119, 53, 8, 0.06);
  }

  .dh-contacto-choice-btn.is-selected {
    background-color: #DEC8B3;
    border-color: #8F5D38;
    font-weight: 500;
    color: #1A1A1A;
    box-shadow: inset 0 0 0 0.5px #8F5D38;
  }

  .dh-contacto-choice-btn:focus-visible {
    outline: 2px solid #773508;
    outline-offset: 2px;
  }

  /* CTA SUBMIT Y ENLACE DIRECTO */
  .dh-contacto-submit-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-top: 4px;
  }

  .dh-contacto-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: #773508;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    padding: 15px 36px;
    min-width: min(100%, 465px);
    min-height: 56px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px rgba(119, 53, 8, 0.48);
    transition:
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .dh-contacto-btn-primary:hover {
    background-color: #5E2805;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px -10px rgba(119, 53, 8, 0.55);
  }

  .dh-contacto-btn-primary:focus-visible {
    outline: 2px solid #1A1A1A;
    outline-offset: 3px;
  }

  .dh-contacto-icon-wa {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
  }

  .dh-contacto-direct-link {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 400;
    color: #1A1A1A;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(26, 26, 26, 0.65);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .dh-contacto-direct-link:hover {
    color: #773508;
    text-decoration-color: #773508;
  }

  .dh-contacto-direct-link:focus-visible {
    outline: 2px solid #773508;
    outline-offset: 4px;
  }

  /* COLUMNA DERECHA: INFORMACIÓN DE CONTACTO */
  .dh-contacto-info-list {
