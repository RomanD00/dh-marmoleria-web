---
import type { MesaModel } from '../data/mesas';

export interface Props {
  model: MesaModel;
  index: number;
}

const { model, index } = Astro.props;
---

<article
  class:list={['mesa-card', 'mesa-card-reveal', { 'mesa-card-delay': index % 2 === 1 }]}
  data-model-id={model.id}
  data-provisional={model.isProvisional ? 'true' : 'false'}
>
  <a
    href={model.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mesa-card-link"
    aria-label={`Consultar por ${model.name} (modelo ilustrativo de referencia)`}
  >
    <!-- Fotografía Editorial Grande -->
    <div class="mesa-card-media">
      <img
        src={model.image}
        alt={model.imageAlt}
        class="mesa-card-img"
        loading={index < 2 ? 'eager' : 'lazy'}
        decoding="async"
        width="900"
        height="810"
      />
    </div>

    <!-- Pie de Tarjeta: Numeración, Divisoria, Nombre del Modelo y Flecha -->
    <div class="mesa-card-footer">
      <span class="mesa-num" aria-hidden="true">{model.num}</span>

      <span class="mesa-divider" aria-hidden="true"></span>

      <h2 class="mesa-title">{model.name}</h2>

      <span class="mesa-arrow" aria-hidden="true">
        <svg
          class="mesa-arrow-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <polyline points="14 6 20 12 14 18"></polyline>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .mesa-card {
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  /* Estado inicial para aparición progresiva al hacer scroll */
  .mesa-card.mesa-card-reveal {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mesa-card.mesa-card-reveal.mesa-card-delay {
    transition-delay: 90ms;
  }

  .mesa-card.mesa-card-reveal.will-animate {
    opacity: 0;
    transform: translateY(18px);
  }

  .mesa-card.mesa-card-reveal.will-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .mesa-card-link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .mesa-card-link:focus-visible {
    outline: 2px solid var(--color-terracotta, #773508);
    outline-offset: 6px;
  }

  /* Fotografía en formato editorial */
  .mesa-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 8.8;
    background-color: #EAE5DC;
    overflow: hidden;
  }

  .mesa-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .mesa-card-link:hover .mesa-card-img,
  .mesa-card-link:focus-visible .mesa-card-img {
    transform: scale(1.03);
  }

  /* Pie de tarjeta editorial */
  .mesa-card-footer {
    position: relative;
    display: flex;
    align-items: center;
    padding: 18px 2px 20px 2px;
    border-bottom: 1px solid rgba(18, 18, 16, 0.14);
  }

  /* Línea inferior con animación discreta al hover */
  .mesa-card-footer::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-terracotta, #773508);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mesa-card-link:hover .mesa-card-footer::after,
  .mesa-card-link:focus-visible .mesa-card-footer::after {
    transform: scaleX(1);
  }

  .mesa-num {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #8B5E3C;
    letter-spacing: 0.04em;
    line-height: 1;
    padding-right: 16px;
    flex-shrink: 0;
  }

  .mesa-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(18, 18, 16, 0.16);
    margin-right: 18px;
    flex-shrink: 0;
  }

  .mesa-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.75rem, 2.3vw, 2.2rem);
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: 'lnum' 1, 'tnum' 1;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #121210;
    margin: 0;
    flex: 1;
    transition: color 0.25s ease;
  }

  .mesa-card-link:hover .mesa-title,
  .mesa-card-link:focus-visible .mesa-title {
    color: var(--color-terracotta, #773508);
  }

  .mesa-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 16px;
    flex-shrink: 0;
  }

  .mesa-arrow-icon {
    width: 22px;
    height: 22px;
    color: #2B2927;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s ease;
  }

  .mesa-card-link:hover .mesa-arrow-icon,
  .mesa-card-link:focus-visible .mesa-arrow-icon {
    transform: translateX(5px);
    color: var(--color-terracotta, #773508);
  }

  @media (max-width: 640px) {
    .mesa-card-footer {
      padding: 14px 2px 16px 2px;
    }

    .mesa-divider {
      height: 26px;
      margin-right: 14px;
    }

    .mesa-title {
      font-size: 1.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesa-card.mesa-card-reveal,
    .mesa-card.mesa-card-reveal.will-animate {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .mesa-card-img,
    .mesa-card-footer::after,
    .mesa-arrow-icon,
    .mesa-title {
      transition: none !important;
    }

    .mesa-card-link:hover .mesa-card-img {
      transform: none !important;
    }
  }
</style>
