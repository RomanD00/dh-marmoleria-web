---
import { SITE_CONFIG } from '../config/site';
import { INSTAGRAM_POSTS, type InstagramPost } from '../data/instagram';

export interface Props {
  posts?: InstagramPost[];
}

const { posts = INSTAGRAM_POSTS } = Astro.props;
---

<section class="taller-section" id="taller">
  <div class="container container-wide taller-container">
    <!-- Cabecera Horizontal sobre el Carrusel -->
    <header class="taller-header-bar">
      <div class="taller-header-copy">
        <div class="taller-eyebrow-row">
          <span class="taller-eyebrow-rule" aria-hidden="true"></span>
          <p class="section-tag taller-eyebrow">EN INSTAGRAM</p>
        </div>

        <div class="taller-heading-row">
          <h2 class="section-heading taller-heading">Desde nuestro taller</h2>
          <a
            href={SITE_CONFIG.social.instagramUrl}
            class="instagram-brand-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="icon-instagram"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span class="instagram-handle">{SITE_CONFIG.social.instagramHandle}</span>
          </a>
        </div>

        <p class="taller-desc">
          Seguinos en el día a día de nuestro taller y mirá nuestras instalaciones reales.
        </p>
      </div>

      <!-- Controles Minimalistas del Carrusel a la derecha -->
      <div class="taller-carousel-controls" role="group" aria-label="Controles del carrusel de Instagram">
        <button
          type="button"
          class="taller-carousel-btn"
          id="igCarouselPrev"
          aria-label="Publicaciones anteriores"
          aria-controls="igCarouselTrack"
          disabled
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="taller-carousel-btn"
          id="igCarouselNext"
          aria-label="Publicaciones siguientes"
          aria-controls="igCarouselTrack"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </header>

    <!-- Carrusel Horizontal de Publicaciones Reales de Instagram -->
    <div class="taller-carousel-viewport">
      <div
        class="taller-photos-grid taller-carousel-track"
        id="igCarouselTrack"
        role="region"
        aria-label="Publicaciones recientes de Instagram de @dh.marmoleria"
        tabindex="0"
      >
        {
          posts.map((post) => (
            <a
              href={post.permalink}
              class="taller-photo-item instagram-post-card"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${post.imageAlt} — Ver publicación en Instagram`}
              data-media-type={post.mediaType}
            >
              <img
                src={post.image}
                alt={post.imageAlt}
                class="taller-img"
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
              />

              {post.mediaType !== 'image' && (
                <span class="ig-media-badge" aria-hidden="true">
                  {post.mediaType === 'reel' ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <polygon points="8 5 19 12 8 19 8 5"></polygon>
                    </svg>
                  ) : (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="8" y="8" width="12" height="12" rx="2.5"></rect>
                      <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                    </svg>
                  )}
                </span>
              )}

              <span class="ig-hover-overlay" aria-hidden="true">
                <span class="ig-hover-pill">
                  <span>Ver en Instagram</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
