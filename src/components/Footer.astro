---
import { SITE_CONFIG, getWhatsAppUrl } from '../config/site';
---

<footer class="site-footer" id="contacto">
  <div class="container footer-container">
    <!-- Fila Superior: 5 Columnas Separadas por Líneas Verticales -->
    <div class="footer-columns">
      <!-- Columna 1: Marca Original + Slogan -->
      <div class="footer-col footer-col-brand">
        <div class="footer-brand-lockup">
          <div class="footer-logo">
            <img
              src={SITE_CONFIG.logoWhite}
              alt={SITE_CONFIG.name}
              class="footer-logo-img"
              width="108"
              height="68"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="footer-brand-text">
            <p class="brand-corp-name">{SITE_CONFIG.name}</p>
            <p class="brand-slogan">{SITE_CONFIG.slogan}</p>
          </div>
        </div>
      </div>

      <!-- Columna 2: Cobertura -->
      <div class="footer-col footer-col-location">
        <div class="footer-location-item">
          <svg
            class="icon-pin"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="location-text">{SITE_CONFIG.coverage}</span>
        </div>
      </div>

      <!-- Columna 3: Contacto WhatsApp -->
      <div class="footer-col footer-col-contact">
        <a
          href={getWhatsAppUrl('Hola Dodera Hermanos Marmolería, quisiera hacer una consulta.')}
          class="footer-whatsapp-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="icon-whatsapp-footer"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path>
          </svg>
          <div class="contact-info">
            <span class="contact-phone">{SITE_CONFIG.contact.phoneDisplay}</span>
            <span class="contact-action">Cotizá por WhatsApp</span>
          </div>
        </a>
      </div>

      <!-- Columna 4: Navegación del Footer (Galería incluida) -->
      <div class="footer-col footer-col-nav">
        <nav aria-label="Navegación de pie de página">
          <ul class="footer-nav-list">
            <li><a href="/" class="footer-nav-link">Inicio</a></li>
            <li><a href="/materiales" class="footer-nav-link">Catálogo</a></li>
            <li><a href="/galeria" class="footer-nav-link">Galería</a></li>
            <li><a href="/contacto" class="footer-nav-link">Contacto</a></li>
          </ul>
        </nav>
      </div>

      <!-- Columna 5: Redes Sociales -->
      <div class="footer-col footer-col-social">
        <div class="social-links" aria-label={`Redes sociales de ${SITE_CONFIG.name}`}>
          <!-- Instagram -->
          <a
            href={SITE_CONFIG.social.instagramUrl}
            class="social-icon-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram de ${SITE_CONFIG.name}`}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href={SITE_CONFIG.social.facebookUrl}
            class="social-icon-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Facebook de ${SITE_CONFIG.name}`}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: Copyright y Enlaces Legales -->
    <div class="footer-bottom-row">
      <p class="copyright-text">
        &copy; {SITE_CONFIG.copyrightYear} {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <div class="legal-links">
        <a href="/contacto" class="legal-link">Privacidad</a>
        <span class="legal-sep" aria-hidden="true">|</span>
        <a href="/contacto" class="legal-link">Términos</a>
        <span class="legal-sep" aria-hidden="true">|</span>
        <a href="/galeria#taller" class="legal-link">Procesos</a>
      </div>
    </div>
  </div>
</footer>
