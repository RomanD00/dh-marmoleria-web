---
import { SITE_CONFIG, getWhatsAppUrl } from '../config/site';
---

<section class="hero-section" id="hero">
  <!-- Fondo Fotográfico Derecho (Obra Real de Dodera Hermanos) -->
  <div class="hero-media-backdrop" aria-hidden="true">
    <img
      src="/assets/hero/hero-obra-principal.jpg"
      alt="Cocina y gran isla central con inglete a 45° en mármol Calacatta realizada por Dodera Hermanos Marmolería"
      class="hero-backdrop-img"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-backdrop-gradient"></div>
  </div>

  <div class="container hero-container">
    <!-- Columna Izquierda: Mensaje Editorial y CTA -->
    <div class="hero-content">
      <p class="hero-eyebrow">PIEDRA / DISEÑO / OFICIO</p>
      <h1 class="hero-title">
        Diseñamos<br />
        espacios únicos,<br />
        no solo mesadas.
      </h1>
      <p class="hero-description">
        Fabricación e instalación a medida de mesadas, islas, revestimientos y escaleras. Trabajamos mármoles seleccionados, granitos, cuarzo y superficies sinterizadas de alta gama.
      </p>

      <div class="hero-actions">
        <a
          href={getWhatsAppUrl('Hola Dodera Hermanos Marmolería, quisiera cotizar un proyecto.')}
          class="btn-hero-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="icon-whatsapp"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path>
          </svg>
          <span>Cotizá tu proyecto por WhatsApp</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-badge-location">
        <svg
          class="icon-pin"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{SITE_CONFIG.coverage}</span>
      </div>
    </div>
  </div>

  <!-- Curva orgánica blanca en el borde inferior -->
  <div class="hero-wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,52 C260,88 520,54 780,64 C1040,74 1240,58 1440,22 L1440,100 L0,100 Z" fill="#F9F8F5"></path>
    </svg>
  </div>
</section>
