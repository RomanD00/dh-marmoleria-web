---
import { MESAS_PREFOOTER_CONTENT } from '../data/mesas';
import { getWhatsAppUrl } from '../config/site';

export interface Props {
  question?: string;
  subtitle?: string;
  actionLabel?: string;
  actionMessage?: string;
}

const {
  question = MESAS_PREFOOTER_CONTENT.question,
  subtitle = MESAS_PREFOOTER_CONTENT.subtitle,
  actionLabel = MESAS_PREFOOTER_CONTENT.actionLabel,
  actionMessage = MESAS_PREFOOTER_CONTENT.actionMessage
} = Astro.props;

const whatsappUrl = getWhatsAppUrl(actionMessage);
---

<section
  class="mesas-prefooter"
  aria-label="Consulta por mesas de arrime"
>
  <div class="container container-wide mesas-prefooter-container">
    <div class="mesas-prefooter-rule" aria-hidden="true"></div>

    <div class="mesas-prefooter-row">
      <div class="mesas-prefooter-copy">
        <h2 class="mesas-prefooter-title">{question}</h2>
        <p class="mesas-prefooter-subtitle">{subtitle}</p>
      </div>

      <div class="mesas-prefooter-vdivider" aria-hidden="true"></div>

      <div class="mesas-prefooter-cta">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp-pill mesas-whatsapp-btn"
          aria-label="Consultar por WhatsApp sobre mesas de arrime"
        >
          <svg
            class="icon-whatsapp"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path>
          </svg>
          <span>{actionLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .mesas-prefooter {
    background-color: var(--color-bg-warm, #F9F8F5);
    padding: 8px 0 56px 0;
  }

  .mesas-prefooter-rule {
    width: 100%;
    height: 1px;
    background-color: rgba(18, 18, 16, 0.13);
    margin-bottom: 36px;
  }

  .mesas-prefooter-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
  }

  .mesas-prefooter-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mesas-prefooter-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: #121210;
    margin: 0;
  }

  .mesas-prefooter-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    color: #3A3835;
    margin: 0;
  }

  .mesas-prefooter-vdivider {
    width: 1px;
    height: 68px;
    background-color: rgba(18, 18, 16, 0.14);
  }

  .mesas-prefooter-cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .mesas-whatsapp-btn {
    padding: 0.85rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    background-color: #6E4726;
    border-radius: 999px;
    color: #FFFFFF;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .mesas-whatsapp-btn:hover {
    background-color: #58371C;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px rgba(18, 18, 16, 0.22);
  }

  @media (max-width: 900px) {
    .mesas-prefooter-row {
      grid-template-columns: 1fr;
      align-items: flex-start;
      gap: 22px;
    }

    .mesas-prefooter-vdivider {
      display: none;
    }

    .mesas-prefooter-cta {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .mesas-prefooter {
      padding: 4px 0 42px 0;
    }

    .mesas-prefooter-rule {
      margin-bottom: 24px;
    }

    .mesas-prefooter-title {
      font-size: 1.75rem;
    }

    .mesas-prefooter-subtitle {
      font-size: 0.9375rem;
    }

    .mesas-whatsapp-btn {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.4rem;
    }
  }
</style>
