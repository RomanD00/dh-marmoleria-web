---
import { getWhatsAppUrl } from '../config/site';

const beneficios = [
  {
    title: 'Cotizaciones rápidas y precisas',
    desc: 'a partir de tus planos técnicos (DWG/DXF).'
  },
  {
    title: 'Asesoramiento técnico especializado',
    desc: 'en materiales, terminaciones y detalles constructivos.'
  },
  {
    title: 'Acompañamiento en todo el proceso',
    desc: 'del desarrollo de la idea a la colocación en obra.'
  }
];
---

<section class="arquitectos-section" id="arquitectos">
  <div class="container arquitectos-container">
    <!-- Columna Izquierda: Información Editorial y Beneficios -->
    <div class="arquitectos-content">
      <span class="badge-pill">PARA PROFESIONALES</span>

      <h2 class="arquitectos-title">
        Canal exclusivo para<br />
        Arquitectos y Diseñadores
      </h2>

      <p class="arquitectos-lead">
        Trabajamos junto a profesionales para resolver cada proyecto en piedra, desde el plano hasta la instalación.
      </p>

      <!-- Lista de 3 Beneficios con Check en Bronce -->
      <ul class="beneficios-list">
        {
          beneficios.map((item) => (
            <li class="beneficio-item">
              <div class="check-icon-wrap" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div class="beneficio-text">
                <h3 class="beneficio-title">{item.title}</h3>
                <p class="beneficio-desc">{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Fila CTA + Frase de Garantía -->
      <div class="arquitectos-cta-row">
        <a
          href={getWhatsAppUrl('Hola Dodera Hermanos Marmolería, soy arquitecto/diseñador y quiero enviarles planos para cotizar.')}
          class="btn-arquitectos-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="icon-whatsapp"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path>
          </svg>
          <span>Enviá planos por WhatsApp</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>

        <div class="tag-garantia">
          <span>TU PROYECTO</span>
          <span>EN BUENAS MANOS</span>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Fotografía Editorial Planos Sobre Mármol -->
    <div class="arquitectos-media">
      <div class="blueprint-photo-frame">
        <img
          src="/assets/arquitectos/canal-arquitectos-planos.jpg"
          alt="Planos arquitectónicos de obra enrollados, muestras de piedra natural y estilográfica sobre mesada de mármol"
          class="blueprint-img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
