---
import { DIFERENCIALES_ITEMS } from '../data/diferenciales';
---

<section class="diferenciales-section" aria-label="Valores diferenciales de Dodera Hermanos Marmolería">
  <div class="container">
    <div class="diferenciales-grid">
      {
        DIFERENCIALES_ITEMS.map((item) => (
          <div class="diferencial-item">
            <div class="diferencial-icon-wrap" aria-hidden="true">
              {item.icon === 'clock' && (
                <svg
                  class="diferencial-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              )}
              {item.icon === 'heart' && (
                <svg
                  class="diferencial-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              )}
              {item.icon === 'crosshair' && (
                <svg
                  class="diferencial-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="22" y1="12" x2="18" y2="12"></line>
                  <line x1="6" y1="12" x2="2" y2="12"></line>
                  <line x1="12" y1="6" x2="12" y2="2"></line>
                  <line x1="12" y1="22" x2="12" y2="18"></line>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              )}
              {item.icon === 'file' && (
                <svg
                  class="diferencial-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              )}
            </div>
            <div class="diferencial-body">
              <h3 class="diferencial-title">{item.title}</h3>
              <p class="diferencial-text">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
