---
import { PRE_FOOTER_CONTENT } from '../data/piletas';
import { getWhatsAppUrl } from '../config/site';

export interface Props {
  question?: string;
  actionLabel?: string;
  actionMessage?: string;
}

const {
  question = PRE_FOOTER_CONTENT.question,
  actionLabel = PRE_FOOTER_CONTENT.actionLabel,
  actionMessage = PRE_FOOTER_CONTENT.actionMessage
} = Astro.props;

const whatsappUrl = getWhatsAppUrl(actionMessage);
---

<section class="prefooter-consultation" aria-label="Asesoramiento personalizado">
  <div class="container container-wide prefooter-container">
    <div class="prefooter-divider" aria-hidden="true"></div>

    <div class="prefooter-content">
      <h2 class="prefooter-title">
        {question}
      </h2>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="prefooter-action"
        aria-label="Consultanos por asesoramiento en piletas por WhatsApp"
      >
        <span class="action-text">{actionLabel}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .prefooter-consultation {
    background-color: var(--color-bg-warm, #F9F8F5);
    padding: 32px 0 54px 0;
  }

  .prefooter-container {
    display: flex;
    flex-direction: column;
  }

  .prefooter-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(18, 18, 16, 0.12);
    margin-bottom: 36px;
  }

  .prefooter-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .prefooter-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    font-style: italic;
    color: #121210;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .prefooter-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    color: #121210;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid #121210;
    transition: color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
  }

  .prefooter-action:hover {
    color: var(--color-terracotta, #773508);
    border-color: var(--color-terracotta, #773508);
    transform: translateX(4px);
  }

  .prefooter-action:focus-visible {
    outline: 2px solid var(--color-terracotta, #773508);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .prefooter-consultation {
      padding: 24px 0 40px 0;
    }

    .prefooter-divider {
      margin-bottom: 24px;
    }

    .prefooter-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }

    .prefooter-title {
      font-size: 1.65rem;
    }
  }
</style>
