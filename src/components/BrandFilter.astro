---
import { PILETAS_FILTERS } from '../data/piletas';
---

<div class="brand-filter-wrapper">
  <div class="container container-wide filter-container">
    <div
      class="filter-group"
      role="group"
      aria-label="Filtrar catálogo de piletas por marca"
    >
      {
        PILETAS_FILTERS.map((filter, index) => (
          <button
            type="button"
            id={`filter-btn-${filter.id}`}
            class:list={['filter-toggle-btn', { active: index === 0 }]}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-filter-target={filter.id}
          >
            <span class="filter-btn-text">{filter.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<style>
  .brand-filter-wrapper {
    background-color: var(--color-bg-warm, #F9F8F5);
    padding: 24px 0 36px 0;
  }

  .filter-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .filter-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    padding: 0;
  }

  .filter-toggle-btn {
    appearance: none;
    background-color: transparent;
    border: 1px solid rgba(18, 18, 16, 0.16);
    border-radius: 999px;
    padding: 8px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #4A4A48;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-toggle-btn:hover {
    color: #121210;
    border-color: rgba(18, 18, 16, 0.4);
    background-color: rgba(18, 18, 16, 0.03);
  }

  .filter-toggle-btn:focus-visible {
    outline: 2px solid var(--color-terracotta, #773508);
    outline-offset: 2px;
  }

  /* ESTADO PRESIONADO / ACTIVO: aria-pressed="true" */
  .filter-toggle-btn.active,
  .filter-toggle-btn[aria-pressed='true'] {
    background-color: #121210;
    color: #F9F8F5;
    border-color: #121210;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(18, 18, 16, 0.12);
  }

  @media (max-width: 640px) {
    .brand-filter-wrapper {
      padding: 18px 0 26px 0;
    }

    .filter-group {
      width: 100%;
      justify-content: flex-start;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }

    .filter-group::-webkit-scrollbar {
      display: none;
    }

    .filter-toggle-btn {
      padding: 7px 18px;
      font-size: 0.75rem;
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
</style>
