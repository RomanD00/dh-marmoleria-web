---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import CatalogDetailSection from '../components/CatalogDetailSection.astro';
import DiferencialesSection from '../components/DiferencialesSection.astro';
import ArquitectosSection from '../components/ArquitectosSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { PILETAS_ITEMS } from '../data/catalogos';
---

<MainLayout
  title="Piletas y Bachas Armadas a Medida en Piedra y Acero | Dodera Hermanos Marmolería"
  description="Fabricación de bachas armadas a medida en mármol, cuarzo, granito y sinterizados con encuentros a 45°. Provisión y colocación de piletas de acero inoxidable Johnson y Neue."
  canonicalPath="/piletas-y-bachas"
  ogImage="/assets/catalogos/02-piletas.jpg"
  includeFaqSchema={true}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Piletas y Bachas', path: '/piletas-y-bachas' }
  ]}
>
  <PageHero
    eyebrow="02. CATÁLOGO DE PILETAS"
    title="Piletas y bachas integradas con precisión milimétrica."
    lead="Realizamos bachas armadas en la misma piedra de tu mesada y colocamos piletas de acero inoxidable de las líneas Johnson y Neue con terminación de traforo rectificada en taller."
    breadcrumbCurrent="Piletas y Bachas"
  />
  <CatalogDetailSection items={PILETAS_ITEMS} />
  <DiferencialesSection />
  <ArquitectosSection />
  <FaqSection />
</MainLayout>
