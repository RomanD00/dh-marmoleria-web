---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import ObrasSection from '../components/ObrasSection.astro';
import TallerSection from '../components/TallerSection.astro';
import DiferencialesSection from '../components/DiferencialesSection.astro';
import ArquitectosSection from '../components/ArquitectosSection.astro';
import { GALERIA_COMPLETA } from '../data/obras';
---

<MainLayout
  title="Galería de Obras y Vida en el Taller | Dodera Hermanos Marmolería"
  description="Recorré nuestras obras realizadas en CABA y GBA: cocinas residenciales con islas en mármol Calacatta a inglete, baños en cuarzo, quinchos en granito y procesos reales en nuestro taller."
  canonicalPath="/galeria"
  ogImage="/assets/obras/01-cocina-residencial.jpg"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Galería', path: '/galeria' }
  ]}
>
  <PageHero
    eyebrow="PORTAFOLIO & OFICIO"
    title="Espacios que hablan por nosotros."
    lead="Obras finalizadas en residencias y proyectos profesionales en Buenos Aires, junto al registro cotidiano de medición, corte y pulido en nuestro propio taller."
    breadcrumbCurrent="Galería"
  />
  <ObrasSection items={GALERIA_COMPLETA} />
  <TallerSection />
  <DiferencialesSection />
  <ArquitectosSection />
</MainLayout>
