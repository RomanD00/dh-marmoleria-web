# ==========================================================================
# .gitignore — Dodera Hermanos Marmolería (Astro SSG + Vercel)
# ==========================================================================

# Salida de compilación Astro y caché de tipos
dist/
.astro/

# Dependencias Node.js
node_modules/

# Variables de entorno y secretos (Nunca subir al repositorio)
.env
.env.*
*.pem
*.key

# Vercel CLI
.vercel/

# Python / utilidades locales
__pycache__/
*.pyc

# Archivos temporales de sistema operativo (Windows / macOS / Linux)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Capturas y archivos de prueba temporales en raíz
render_1440_pass*.png
*_test.png
*_zoom*.png
*_crop*.png
lighthouse-*
*.tmp
*.log
