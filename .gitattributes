# Normalización automática de finales de línea
* text=auto eol=lf

# Código fuente web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf

# Recursos gráficos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
